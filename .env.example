# Never paste real values into this file or commit a populated .env file.
# Store secrets in the protected environment-variable settings of the machine or host.

# Required to connect the Discord bot.
DISCORD_TOKEN=

# Selects config/environments/<name>.yaml.
NERP_ENVIRONMENT=test

# Database connection. SQLite is a local-development default; production will use a managed database URL.
DATABASE_URL=sqlite+aiosqlite:///./data/nerp_forms_bot.db

# Google service-account credential file supplied securely to the runtime, never committed.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_FORMS_POLL_INTERVAL_SECONDS=60
